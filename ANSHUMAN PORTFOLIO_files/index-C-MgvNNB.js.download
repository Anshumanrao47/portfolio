        .workspace-loader {
          position: fixed;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          background: var(--gradient-chat-bg);
          z-index: 9999;
        }
        .workspace-loader__inner {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 20px;
          animation: wl-fade-in 0.4s ease;
        }
        .workspace-loader__logo {
          width: 72px;
          height: 72px;
          object-fit: contain;
          border-radius: 16px;
          animation: wl-pulse 2.4s ease-in-out infinite;
        }
        .workspace-loader__text {
          font-size: 13px;
          color: var(--text-muted);
          letter-spacing: 0.02em;
          display: flex;
          align-items: baseline;
          gap: 1px;
          margin: 0;
          font-family: inherit;
        }
        .workspace-loader__dots span {
          display: inline-block;
          opacity: 0;
          animation: wl-dot 1.4s ease-in-out infinite;
        }
        .workspace-loader__dots span:nth-child(1) { animation-delay: 0s; }
        .workspace-loader__dots span:nth-child(2) { animation-delay: 0.2s; }
        .workspace-loader__dots span:nth-child(3) { animation-delay: 0.4s; }

        @keyframes wl-fade-in {
          from { opacity: 0; transform: translateY(8px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes wl-pulse {
          0%, 100% { transform: scale(1);    opacity: 1; }
          50%       { transform: scale(0.96); opacity: 0.75; }
        }
        @keyframes wl-dot {
          0%, 60%, 100% { opacity: 0; }
